    given-names: "Christian-Maximilian"
    affiliation: "ZWEK – Centre for Training and Competence Development, Hochschule Düsseldorf – University of Applied Sciences"
    orcid: "https://orcid.org/0000-0001-7946-0461"
license: GPL-3.0-or-later
version: "0.1.0"
date-released: "2026-05-29"
repository-code: "https://github.com/HSD-ZWEK/whisper-transcribe-de"
url: "https://github.com/HSD-ZWEK/whisper-transcribe-de"
keywords:
  - whisper
  - whisperx
  - transcription
  - speech-to-text
  - german
  - research-software
  - educational-technology
  - higher-education
